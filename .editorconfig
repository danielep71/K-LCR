#==============================================================================
# .editorconfig
#------------------------------------------------------------------------------
# PURPOSE
#   Provide the editing baseline for the K-LCR repository.
#
# POLICY
#   - Exported VBA source uses CRLF and 4-space indentation.
#   - Documentation, GitHub configuration, and cross-platform tooling use LF.
#   - YAML, JSON, XML, and JavaScript use 2-space indentation.
#   - Python and shell scripts use 4-space indentation.
#   - Trailing whitespace is removed everywhere, Markdown included: the
#     tracked-text gate (tools/check_files.py) rejects it. Write an explicit
#     Markdown line break as a trailing backslash or <br>.
#   - Future exported VBA source is authored with ASCII-only characters.
#     This source rule does not prove a VBE encoding or Windows code page.
#   - VBE import/export encoding and round-trip behavior need host evidence
#     in issues #14/#15; no charset conversion is configured here.
#
# RELATIONSHIP WITH .gitattributes
#   .editorconfig controls how supporting editors create and save working-tree
#   files. .gitattributes remains authoritative for Git normalization, binary
#   classification, merge and diff behavior, Linguist, and release archives.
#==============================================================================

root = true


#------------------------------------------------------------------------------
# DEFAULT TEXT POLICY
#------------------------------------------------------------------------------
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4


#------------------------------------------------------------------------------
# EXPORTED VBA SOURCE
#------------------------------------------------------------------------------
# Do not set charset: an ASCII-only source rule is distinct from untested
# VBE import/export encoding and code-page behavior (issues #14/#15).
[*.{bas,cls,frm}]
end_of_line = crlf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# PYTHON TOOLING
#------------------------------------------------------------------------------
[*.{py,pyw}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# NODE / JAVASCRIPT TOOLING
#------------------------------------------------------------------------------
[*.{js,mjs,cjs}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# GITHUB / STRUCTURED CONFIGURATION
#------------------------------------------------------------------------------
[*.{yml,yaml,json,jsonc}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# XML
#------------------------------------------------------------------------------
[*.xml]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# OTHER CROSS-PLATFORM TEXT
#------------------------------------------------------------------------------
[*.{toml,cfg,csv,tsv,svg}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# DOCUMENTATION
#------------------------------------------------------------------------------
[*.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true
# Use a trailing backslash or <br> for a hard line break; the tracked-text
# gate rejects trailing whitespace in every checked file.
trim_trailing_whitespace = true

[*.txt]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[LICENSE]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# WINDOWS-NATIVE SCRIPTS / HOST-SENSITIVE TEXT
#------------------------------------------------------------------------------
# Do not force an encoding: some Windows-native formats remain host-specific.
[*.{bat,cmd,ps1,psm1,psd1,vbs,reg,ini}]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# POSIX SHELL SCRIPTS
#------------------------------------------------------------------------------
[*.sh]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# REPOSITORY CONTROL FILES
#------------------------------------------------------------------------------
[{.editorconfig,.gitattributes,.gitignore,.gitkeep}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true


#------------------------------------------------------------------------------
# REGULATORY SOURCE COPIES
#------------------------------------------------------------------------------
# No copies are committed to K-LCR. Add an exact-path byte-preservation rule
# only if a source is approved and its hash and redistribution terms are known.
